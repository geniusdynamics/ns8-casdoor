#!/usr/bin/env python3
# Load the init data (module API application) into a Podman secret that the
# casdoor-app container reads with initDataFile. Runs before every start.
import json
import subprocess
from casdoor_directory import init_data

subprocess.run(["podman", "secret", "rm", "casdoor-init-data"],
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
subprocess.run(["podman", "secret", "create", "casdoor-init-data", "-"],
               input=json.dumps(init_data()), text=True, check=True, stdout=subprocess.DEVNULL)
