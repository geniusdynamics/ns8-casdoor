#!/usr/bin/env python3
# Apply a new built-in/admin password, only when the request carries one.
import json
import sys
from casdoor_directory import set_admin_password, wait_ready

request = json.load(sys.stdin)
password = request.get("admin_password", "")
if password:
    if not wait_ready():
        raise SystemExit("Casdoor did not start.")
    set_admin_password(password)
