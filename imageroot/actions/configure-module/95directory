#!/usr/bin/env python3
import json
import sys
from casdoor_directory import read, reconcile, CONFIG

request = json.load(sys.stdin)
if "ldap_domain" in request:
    reconcile(request["host"], request["ldap_domain"], request.get("ldap_organization", ""))
else:
    current = read(CONFIG)
    if current:
        reconcile(request["host"], current["domain"], current["organization"])
