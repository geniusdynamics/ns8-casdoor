{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure casdoor",
    "$id": "http://nethserver.org/json-schema/task/input/casdoor/configure-module",
    "description": "Configure casdoor",
    "examples": [
        {
            "host": "casdoor.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'casdoor.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "ldap_domain": {
            "type": "string",
            "maxLength": 253
        },
        "ldap_organization": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]*$"
        },
        "admin_password": {
            "type": "string",
            "description": "New built-in/admin password, sent only to change it",
            "anyOf": [
                {
                    "maxLength": 0
                },
                {
                    "minLength": 12,
                    "maxLength": 100,
                    "pattern": "^\\S+$"
                }
            ]
        }
    }
}
