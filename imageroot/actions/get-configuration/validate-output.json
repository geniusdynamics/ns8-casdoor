{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get casdoor settings",
    "$id": "http://nethserver.org/json-schema/task/input/casdoor/get-configuration",
    "description": "Get casdoor settings",
    "examples": [
        {
            "host": "casdoor.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'casdoor.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "ldap_domain": {
            "type": "string",
            "maxLength": 253
        },
        "ldap_organization": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]*$"
        },
        "ldap_domains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
